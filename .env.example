# Application
ENV=development
PORT=8080

# Database
DATABASE_URL=postgres://starterkit:starterkit@localhost:5432/starterkit?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Argon2id (defaults are sensible, only change if you know what you're doing)
ARGON2_TIME=3
ARGON2_MEMORY=65536
ARGON2_THREADS=4
ARGON2_KEYLEN=32
ARGON2_SALTLEN=16
